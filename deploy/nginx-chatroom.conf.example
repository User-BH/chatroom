# پیکربندی Nginx
# مسیرها، server_name و گواهی را با سرور خود تطبیق دهید.

server {
    listen 80;
    server_name chat.example.ir;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name chat.example.ir;

    # گواهی باید بدون اینترنت قابل تمدید باشد (CA داخلی یا گواهی بلندمدت)
    ssl_certificate     /etc/chatroom/tls/fullchain.pem;
    ssl_certificate_key /etc/chatroom/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/chatroom;
    index index.php;
    charset utf-8;
    server_tokens off;

    # کمی بیشتر از MAX_FILE_SIZE برنامه؛ upload_max_filesize و post_max_size در PHP هم همین باشد
    client_max_body_size 12m;

    add_header X-Content-Type-Options "nosniff" always;

    # پوشه‌هایی که هرگز نباید از وب سرو شوند
    location ~ ^/(uploads|logs|includes|scripts|migrations|tests|deploy|docker)(/|$) {
        deny all;
    }

    # فایل‌های مخفی و غیر وب
    location ~ (^|/)\. {
        deny all;
    }
    location ~ \.(sql|log|md|txt|ini|yml|example|conf|bak|tgz|zip)$ {
        deny all;
    }

    # فایل‌هایی که فقط include می‌شوند
    location ~ ^/(config|config\.local|config\.local\.example|db|functions)\.php(/|$) {
        deny all;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $https if_not_empty;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
